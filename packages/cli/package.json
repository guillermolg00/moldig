{
  "name": "moldig",
  "version": "0.0.0",
  "description": "CleanMyMac for your AI setup: scan, review and clean the skills, MCP servers, context files, memories and cache that AI coding harnesses leave across your projects.",
  "keywords": [
    "ai",
    "claude-code",
    "cleanup",
    "cli",
    "codex",
    "copilot",
    "cursor",
    "gemini-cli",
    "mcp",
    "opencode",
    "skills"
  ],
  "homepage": "https://github.com/guillermolg00/moldig#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillermolg00/moldig.git",
    "directory": "packages/cli"
  },
  "bin": {
    "moldig": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "proto": "tsdown --config tsdown.proto.config.ts -l silent && node dist-proto/proto.mjs"
  },
  "devDependencies": {
    "@moldig/core": "workspace:*",
    "@types/react": "^19.2.18",
    "ink": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "react": "^19.2.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
