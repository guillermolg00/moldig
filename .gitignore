# Planning scratch stays local. So does the research: those notes describe this machine in
# detail (directory layouts, counts, project names). The decisions and the agent conventions
# are design documentation and are tracked, because the README links to them.
/.scratch/
/docs/research/

# Agent worktrees (this session's subagents branch the repo into .claude/worktrees/<agent>)
/.claude/worktrees/

# Tooling (anchored so committed fixture trees can contain these names)
/node_modules/
/packages/*/node_modules/
/apps/*/node_modules/
/packages/*/dist/
/apps/*/dist/
/coverage/
/packages/*/*.tgz
.DS_Store

# Capture sources (real directory names of this machine; see fixtures/_capture/sources.example.json)
/fixtures/_capture/sources.local.json

# TanStack Start build artefacts (the route tree it generates is tracked; these are not)
/apps/*/.tanstack/
/apps/*/.output/
